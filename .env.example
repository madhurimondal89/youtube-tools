# ============================================
# YouTube Creator Toolkit Pro — Environment Variables
# ============================================
# Copy this file to .env.local and fill in your values

# ── YouTube Data API v3 ──────────────────────
# Get free key at: https://console.cloud.google.com
# Enable "YouTube Data API v3" → Create Credentials → API Key
YOUTUBE_API_KEY=your_youtube_api_key_here

# ── Google Gemini AI (Free Fallback) ──────────
# Get free key at: https://aistudio.google.com
# Model used: gemini-1.5-flash (free tier)
GEMINI_API_KEY=your_gemini_api_key_here

# ── Universal OpenAI-Compatible AI (Optional Server Fallback) ──
# Works with Groq, OpenRouter, DeepSeek, Ollama, etc.
# AI_ENDPOINT=https://api.groq.com/openai/v1
# AI_API_KEY=gsk_...
# AI_MODEL=llama-3.3-70b-versatile

# ── App Config ───────────────────────────────
NEXT_PUBLIC_APP_URL=http://localhost:3000
NEXT_PUBLIC_APP_NAME=YouTube Creator Toolkit Pro

# ── Analytics (Optional) ─────────────────────
# NEXT_PUBLIC_GA_ID=G-XXXXXXXXXX
# NEXT_PUBLIC_CLARITY_ID=xxxxxxxxxx
